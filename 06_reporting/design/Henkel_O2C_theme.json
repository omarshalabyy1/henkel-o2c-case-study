{
  "name": "Henkel O2C",
  "dataColors": [
    "#2B2B2B",
    "#8A8A84",
    "#6B8CAE",
    "#C2410C",
    "#A9A9A3",
    "#E2001A",
    "#1E8C4E",
    "#4A4A46"
  ],
  "background": "#FFFFFF",
  "foreground": "#1D1D1B",
  "foregroundNeutralSecondary": "#6B6B66",
  "foregroundNeutralTertiary": "#A9A9A3",
  "tableAccent": "#E2001A",
  "good": "#1E8C4E",
  "neutral": "#A9A9A3",
  "bad": "#C2410C",
  "maximum": "#2B2B2B",
  "center": "#A9A9A3",
  "minimum": "#EEEEEA",
  "null": "#D9D9D4",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D1D1B"
    },
    "title": {
      "fontSize": 15,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D1D1B"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D1D1B"
    },
    "label": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#6B6B66"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "alignment": "center",
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 15,
            "fontColor": {
              "solid": {
                "color": "#1D1D1B"
              }
            }
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#6B6B66"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#6B6B66"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "legend": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#6B6B66"
              }
            },
            "position": "Top"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "selection": [
          {
            "singleSelect": true,
            "strictSingleSelect": true,
            "selectAllCheckboxEnabled": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEEEEA"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#6B6B66"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "outline": "BottomOnly"
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "fontColorPrimary": {
              "solid": {
                "color": "#1D1D1B"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1D1D1B"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F5F3"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E4E4E0"
              }
            }
          }
        ]
      }
    }
  }
}